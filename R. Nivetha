:root {
--ink: #1f2540;
--muted: #6b7190;
--bg: #f3f4fb;
--panel: #ffffff;
--brand: #5b3df5;
--brand-dark: #3a22b8;
--income: #12a36b;
--expense: #e5484d;
--line: #e4e6f2;
--radius: 14px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
font-family: "Poppins", "Segoe UI", Arial, sans-serif;
background: var(--bg);
color: var(--ink);
line-height: 1.5;
}
.topbar {
display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
padding: 18px 32px;
background: linear-gradient(120deg, #3a22b8, #5b3df5 55%, #8a5cf6);
color: #fff;
}
.brand { display: flex; align-items: center; gap: 14px; }
.logo {
width: 48px; height: 48px; border-radius: 14px; background: rgba(255,255,255,.18);
display: grid; place-items: center; font-size: 26px; font-weight: 700;
}
.brand h1 { font-size: 24px; letter-spacing: .3px; }
.brand p { font-size: 12.5px; opacity: .85; }
.owner { font-size: 13px; background: rgba(255,255,255,.16); padding: 6px 14px; border-radius: 20px; }
.container { max-width: 1120px; margin: 22px auto; padding: 0 18px; display: grid; gap: 18px; }
.cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.card {
background: var(--panel); border-radius: var(--radius); padding: 16px 18px;
border-left: 6px solid var(--brand); box-shadow: 0 4px 14px rgba(40,40,100,.07);
}
.card span { display: block; font-size: 12.5px; color: var(--muted); }
.card strong { font-size: 24px; }
.card.income { border-color: var(--income); } .card.income strong { color: var(--income); }
.card.expense { border-color: var(--expense); } .card.expense strong { color: var(--expense); }
.card.balance { border-color: var(--brand); } .card.balance strong.neg { color: var(--expense); }
.card.count { border-color: #f5a524; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.panel {
background: var(--panel); border-radius: var(--radius); padding: 20px;
box-shadow: 0 4px 14px rgba(40,40,100,.07);
}
.panel h2 { font-size: 17px; color: var(--brand-dark); margin-bottom: 12px; }
.panel h2 small { font-weight: 400; color: var(--muted); font-size: 12px; margin-left: 6px; }
label { display: block; font-size: 12.5px; color: var(--muted); margin-bottom: 10px; }
input, select {
width: 100%; margin-top: 4px; padding: 9px 11px; font: inherit; font-size: 14px; color: var(--ink);
border: 1.5px solid var(--line); border-radius: 9px; background: #fff;
}
input:focus, select:focus { outline: none; border-color: var(--brand); }
.btnrow, .inline { display: flex; gap: 10px; }
.inline input { margin-top: 0; }
.btn {
border: none; cursor: pointer; font: inherit; font-weight: 600; font-size: 13.5px;
padding: 9px 18px; border-radius: 9px; white-space: nowrap;
}
.btn.primary { background: var(--brand); color: #fff; }
.btn.primary:hover { background: var(--brand-dark); }
.btn.ghost { background: #eceefb; color: var(--brand-dark); }
.btn.small { padding: 4px 10px; font-size: 12px; }
.btn.edit { background: #e8f0ff; color: #1d4ed8; }
.btn.del { background: #ffe9ea; color: #c4262c; }
.error { color: var(--expense); font-size: 12.5px; min-height: 18px; margin: 4px 0; }
.hint { font-size: 12px; color: var(--muted); margin-top: 8px; }
.chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.chips li {
display: flex; align-items: center; gap: 6px; background: #eef0ff; color: var(--brand-dark);
padding: 5px 6px 5px 12px; border-radius: 20px; font-size: 13px;
}
.chips button {
border: none; background: #fff; color: var(--expense); width: 20px; height: 20px;
border-radius: 50%; cursor: pointer; font-weight: 700; line-height: 1;
}
.filters { display: grid; grid-template-columns: repeat(5, 1fr) auto; gap: 12px; align-items: end; }
.filters label { margin-bottom: 0; }
.tablewrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th { background: #f0f1fb; color: var(--brand-dark); text-align: left; padding: 9px 10px; font-size: 12.5px; }
td { padding: 9px 10px; border-bottom: 1px solid var(--line); }
.r { text-align: right; }
.tag { padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }
.tag.Income { background: #dcf7ea; color: #0b7a4f; }
.tag.Expense { background: #ffe5e6; color: #b3262b; }
.amt.Income { color: var(--income); font-weight: 600; }
.amt.Expense { color: var(--expense); font-weight: 600; }
.empty { text-align: center; color: var(--muted); padding: 14px; font-size: 13.5px; }
.charthead { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 8px; }
.charthead h2 { margin: 0; }
.charthead select { width: auto; margin: 0; }
canvas { width: 100%; height: auto; display: block; }
.footer { text-align: center; padding: 18px; font-size: 12.5px; color: var(--muted); }
@media (max-width: 900px) {
.cards { grid-template-columns: repeat(2, 1fr); }
.grid { grid-template-columns: 1fr; }
.filters { grid-template-columns: 1fr 1fr; }
}
